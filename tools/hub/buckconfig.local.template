# The client side of Mercury's hub remote execution, for a job that builds
# buck2 with .buckconfig.hub. Copy it to the checkout's .buckconfig.local,
# which is untracked, and start the buck2 daemon with BUILDBUDDY_API_KEY set
# in its environment: the key stays a reference here and is never written
# out. There is no tls_ca_certs key, as in mwb's own reference config for hub
# (tools/buck2/reference_buckconfigs/hub-remote-execution).

[buck2_re_client]
engine_address       = grpc://buck2-remote-execution.hub.internal.mercury.com:443
action_cache_address = grpc://buck2-remote-execution.hub.internal.mercury.com:443
cas_address          = grpc://buck2-remote-execution.hub.internal.mercury.com:443
tls                  = true
http_headers         = x-buildbuddy-api-key:$BUILDBUDDY_API_KEY

# The build's events, to hub's BuildBuddy, through the same connection and
# credential, so the invocation shows at re.hub.internal.
[bes]
connection   = re_client
# The credential, named here rather than borrowed from [buck2_re_client]: a
# buck2 whose BES sink copies the RE client's headers without expanding them
# sends the literal $BUILDBUDDY_API_KEY, and BuildBuddy refuses the stream.
header       = x-buildbuddy-api-key=$BUILDBUDDY_API_KEY
# BuildBuddy builds an invocation page from Bazel events; buck2's default
# format is its own (remote_sink_config.rs), which BuildBuddy cannot draw.
event_format = bazel
# BuildBuddy acknowledges a stream only at EOF, so buck2 keeps ten times this
# many events for replay; the default 10,000 lost the tail of large runs
# (MercuryTechnologies/buck2#79).
buffer_size  = 100000
results_url  = https://re.hub.internal/invocation/
