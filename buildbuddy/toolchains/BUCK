write_file(
    name = "unsupported_ocaml_tool",
    content = [
        "#!/usr/bin/env bash",
        "echo 'BuildBuddy OCaml toolchain is not pinned yet' >&2",
        "echo 'Add a hermetic opam switch archive before building OCaml remotely.' >&2",
        "exit 1",
    ],
    is_executable = True,
    out = "unsupported_ocaml_tool.sh",
)

