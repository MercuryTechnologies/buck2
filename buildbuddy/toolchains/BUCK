downloaded_rust_toolchain(
    name = "rust",
    default_edition = "2024",
    # Release builds pass e.g. -c rust.rustc_flags="-Copt-level=3 -Cstrip=debuginfo";
    # the default is a debug build, as for cargo.
    rustc_flags = read_root_config("rust", "rustc_flags", "").split(),
    # The compiler runs on the remote execution workers, which are x86_64
    # Linux whatever the target is; the prelude's default would follow the
    # target configuration and fetch an aarch64 rustc for an aarch64 build.
    rustc_host_triple = "x86_64-unknown-linux-gnu",
    rustc_target_triple = select({
        "DEFAULT": select({
            "prelude//cpu:arm64": "aarch64-unknown-linux-gnu",
            "prelude//cpu:x86_64": "x86_64-unknown-linux-gnu",
        }),
        "prelude//abi:musl": select({
            "prelude//cpu:arm64": "aarch64-unknown-linux-musl",
            "prelude//cpu:x86_64": "x86_64-unknown-linux-musl",
        }),
    }),
    rust_toolchain = "root//:rust-toolchain",
    visibility = ["PUBLIC"],
)

