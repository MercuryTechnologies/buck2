load("//:test_utils.bzl", "assert_output")

oncall("build_infra")

# `container_run` makes a Linux program runnable from a Mac: `buck2 run` runs
# it in a Linux container there, and directly everywhere else. See
# docs/users/how_tos/container_run.md.

_UNIX = [
    "config//os:linux",
    "config//os:macos",
]

sh_binary(
    name = "hello_bin",
    compatible_with = _UNIX,
    main = "hello.sh",
)

container_run(
    name = "hello",
    binary = ":hello_bin",
    compatible_with = _UNIX,
    env = {"VIA_LAUNCHER": "yes"},
)

# Only Linux-configured targets are wrapped: on a Linux host the launcher execs
# `hello_bin` directly (with `env` applied); on a macOS host this example is
# configured for macOS, so `hello` is a plain alias.
assert_output(
    name = "check_hello",
    command = "$(exe_target :hello)",
    compatible_with = _UNIX,
    output = select({
        "DEFAULT": "via launcher: no",
        "config//os:linux": "via launcher: yes",
    }),
)

# Drives the container path end to end, with a fake `container` CLI, on every
# host.
container_run(
    name = "hello_forced",
    binary = ":hello_bin",
    compatible_with = _UNIX,
    enabled = True,
    env = {"VIA_LAUNCHER": "yes"},
)

export_file(
    name = "fake_container.sh",
    compatible_with = _UNIX,
)

sh_test(
    name = "container_path_test",
    args = [
        "$(location :fake_container.sh)",
        "$(exe_target :hello_forced)",
    ],
    compatible_with = _UNIX,
    test = "check_container_path.sh",
)

# A wrapped test: `buck2 test` runs it through the launcher, keeping its `env`.
sh_test(
    name = "check_test_bin",
    compatible_with = _UNIX,
    env = {"TEST_ENV": "1"},
    test = "check_test.sh",
)

container_run(
    name = "check_test",
    binary = ":check_test_bin",
    compatible_with = _UNIX,
    env = {"VIA_LAUNCHER": "1"},
)

# Unit tests for the launcher, using fake `container` and `uname` programs to
# cover the macOS code path on any host.
sh_test(
    name = "launcher_test",
    args = ["$(location prelude//container/tools:container_run.sh)"],
    compatible_with = _UNIX,
    test = "test_container_run.sh",
)
