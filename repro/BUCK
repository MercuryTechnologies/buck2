rust_binary(
    name = "ring_hello",
    srcs = ["main.rs"],
    deps = [
        ":ring-0.17",
    ],
)

# Negative control: a plain rust binary with no `-fstack-protector-strong` C
# code links fine under the same hermetic toolchain. Only `ring_hello` (whose
# ring C archive is appended after `-lc` under `--as-needed`) fails. This
# confirms the toolchain isn't universally broken — the failure is specific to
# a native lib needing an ld-linux-only symbol from a post-`-lc` position.
rust_binary(
    name = "plain_hello",
    srcs = ["plain.rs"],
    crate_root = "plain.rs",
)
