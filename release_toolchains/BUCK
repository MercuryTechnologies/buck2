load("@prelude//tests:test_toolchain.bzl", "noop_test_toolchain")
load("@prelude//toolchains:cxx.bzl", "system_cxx_toolchain")
load("@prelude//toolchains:genrule.bzl", "system_genrule_toolchain")
load("@prelude//toolchains:go.bzl", "system_go_bootstrap_toolchain", "system_go_toolchain")
load("@prelude//toolchains:haskell.bzl", "system_haskell_toolchain")
load("@prelude//toolchains:ocaml.bzl", "system_ocaml_toolchain")
load("@prelude//toolchains:python.bzl", "python_bootstrap_toolchain", "system_python_bootstrap_toolchain", "system_python_toolchain")
load("@prelude//toolchains:remote_test_execution.bzl", "remote_test_execution_toolchain")
load("@prelude//toolchains:rust.bzl", "downloaded_rust_toolchain")
load("@prelude//toolchains/cxx/llvm:defs.bzl", "cxx_llvm_toolchain", "download_llvm_distribution")

oncall("build_infra")

# The toolchains that build buck2's static release binaries, each pinned by
# sha256: LLVM from this fork's release, the musl headers, and the Rust channel
# of rust-toolchain.toml. `.buckconfig.local-musl` points the `toolchains` cell
# alias here. Every toolchain buck2-bin reaches but does not compile with is defined
# as the shim defines it (shim/BUCK); a toolchain rule cannot be an alias.

download_llvm_distribution(
    name = "llvm_dist",
    # Remote images often have tar and gzip but no zstd CLI.
    archive_type = "tar.gz",
    sha256 = "3590e82cd56ff58cdf71732b0fbc3eb8f21d4fc00b8592d1329af522381f08cc",
    target = "linux-amd64-musl",
    # hermeticbuild/hermetic-llvm's llvm-22.1.7-1 repacked as gzip, mirrored to
    # a release of this fork.
    url = "https://github.com/MercuryTechnologies/buck2/releases/download/toolchains-llvm-22.1.7-2026-10-17/llvm-toolchain-minimal-22.1.7-linux-amd64-musl.tar.gz",
    # hub_re//:gnu-exec-sysroot-x86_64-selftest links against it.
    visibility = ["hub_re//..."],
)

# A target configuration carrying prelude//abi/constraints:musl compiles C
# against these headers and links a static executable; the LLVM archive ships
# no libc headers. rustc links the musl C runtime and libc.a that the Rust
# musl target carries as self-contained objects
# (https://doc.rust-lang.org/rustc/codegen-options/index.html#link-self-contained).
http_archive(
    name = "musl-src",
    sha256 = "a9a118bbe84d8764da0ea0d28b3ab3fae8477fc7e4085d90102b8596fc7c75e4",
    strip_prefix = "musl-1.2.5",
    urls = ["https://musl.libc.org/releases/musl-1.2.5.tar.gz"],
)

genrule(
    name = "musl-sysroot-x86_64",
    out = "sysroot",
    cmd = "sh $SRCDIR/musl_sysroot.sh $(location :musl-src) x86_64 $OUT",
    srcs = ["musl_sysroot.sh"],
)

genrule(
    name = "musl-sysroot-aarch64",
    out = "sysroot",
    cmd = "sh $SRCDIR/musl_sysroot.sh $(location :musl-src) aarch64 $OUT",
    srcs = ["musl_sysroot.sh"],
)

cxx_llvm_toolchain(
    name = "cxx_linux",
    cxx_compiler_flags = ["-std=c++20"],
    distribution = ":llvm_dist",
    sysroot = select({
        # The gnu configuration is the execution platform's, which links the
        # build scripts and proc macros. On an executor with a nix daemon the
        # sysroot comes from its store (hub_re/BUCK); elsewhere the host
        # provides glibc and libgcc.
        "DEFAULT": select({
            "DEFAULT": None,
            "hub_re//:nix_daemon": "hub_re//:gnu-exec-sysroot-x86_64[sysroot]",
        }),
        "prelude//abi:musl": select({
            "prelude//cpu:arm64": ":musl-sysroot-aarch64",
            "prelude//cpu:x86_64": ":musl-sysroot-x86_64",
        }),
    }),
    target = select({
        "DEFAULT": select({
            "prelude//cpu:arm64": "aarch64-unknown-linux-gnu",
            "prelude//cpu:x86_64": "x86_64-unknown-linux-gnu",
        }),
        "prelude//abi:musl": select({
            "prelude//cpu:arm64": "aarch64-unknown-linux-musl",
            "prelude//cpu:x86_64": "x86_64-unknown-linux-musl",
        }),
    }),
    visibility = ["PUBLIC"],
)

# macOS links against Apple's SDK, which only Xcode or its command-line tools provide and which may
# not be redistributed, so the compiler and SDK there are the machine's, found through xcrun.
system_cxx_toolchain(
    name = "cxx_macos",
)

toolchain_alias(
    name = "cxx",
    actual = select({
        "DEFAULT": ":cxx_linux",
        "prelude//os:macos": ":cxx_macos",
    }),
    visibility = ["PUBLIC"],
)

alias(
    name = "cxx_no_default_deps",
    actual = ":cxx",
    visibility = ["PUBLIC"],
)

downloaded_rust_toolchain(
    name = "rust",
    # From https://static.rust-lang.org/dist/<date>/channel-rust-nightly.toml.sha256.
    # A rust-toolchain.toml bump adds its channel here, or the install fails.
    channel_manifest_sha256 = {
        "nightly-2026-05-22": "904b259e0c838741de7a50525c9fc359d12332c71ee236ad51c07598db6544c0",
        "nightly-2026-08-15": "0eee8c54cacbb2a6d8867a9dc9e9cafe936dd45bb6e2f36c8aa3e25b4ddafc38",
    },
    default_edition = "2024",
    host_runtime_libs = select({
        "DEFAULT": "hub_re//:rustc-runtime-libs",
        "prelude//os:macos": None,
    }),
    # Release builds pass e.g. -c rust.rustc_flags="-Copt-level=3 -Cstrip=debuginfo";
    # the default is a debug build, as for cargo.
    rustc_flags = read_root_config("rust", "rustc_flags", "").split(),
    # The compiler runs on x86_64 Linux whatever the target is; the prelude's
    # default would follow the target configuration and fetch an aarch64 rustc
    # for an aarch64 build.
    rustc_host_triple = select({
        "DEFAULT": "x86_64-unknown-linux-gnu",
        "prelude//os:macos": "aarch64-apple-darwin",
    }),
    rustc_target_triple = select({
        "prelude//os:macos": "aarch64-apple-darwin",
        "DEFAULT": select({
            "prelude//cpu:arm64": "aarch64-unknown-linux-gnu",
            "prelude//cpu:x86_64": "x86_64-unknown-linux-gnu",
        }),
        "prelude//abi:musl": select({
            "prelude//cpu:arm64": "aarch64-unknown-linux-musl",
            "prelude//cpu:x86_64": "x86_64-unknown-linux-musl",
        }),
    }),
    rust_toolchain = "root//:rust-toolchain",
    visibility = ["PUBLIC"],
)

system_genrule_toolchain(
    name = "genrule",
    visibility = ["PUBLIC"],
)

