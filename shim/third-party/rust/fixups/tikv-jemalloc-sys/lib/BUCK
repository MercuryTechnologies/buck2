# rustc's -lstatic=jemalloc looks for libjemalloc.a in a -Lnative directory;
# these give the archive reindeer's cxx_library builds that name and place.
# See fixups.toml for why the crate bundles it instead of depending on it.

genrule(
    name = "x86_64",
    out = "lib",
    cmd = "mkdir -p $OUT && cp $(location //third-party/rust:tikv-jemalloc-sys-jemalloc-x86_64[static]) $OUT/libjemalloc.a",
    visibility = ["//third-party/rust/..."],
)

genrule(
    name = "aarch64",
    out = "lib",
    cmd = "mkdir -p $OUT && cp $(location //third-party/rust:tikv-jemalloc-sys-jemalloc-aarch64[static]) $OUT/libjemalloc.a",
    visibility = ["//third-party/rust/..."],
)
