[cells]
prelude = prelude
none = none

[cell_aliases]
config = prelude
ovr_config = gh_facebook_buck2_shims_meta
antlir = none
bazel_skylib = gh_facebook_buck2_shims_meta
buck = gh_facebook_buck2_shims_meta
fbcode = gh_facebook_buck2_shims_meta
fbcode_macros = gh_facebook_buck2_shims_meta
fbsource = gh_facebook_buck2_shims_meta
shim = gh_facebook_buck2_shims_meta
toolchains = gh_facebook_buck2_shims_meta

[external_cells]
# Use the checkout prelude, so prelude/ changes are visible before a buck2 binary
# that bundles them has been bootstrapped. It also makes a buck-built buck2 embed
# this checkout's prelude/: app/buck2_external_cells_bundled bundles
# prelude//:source_listing, which under `bundled` would be the bootstrap's copy.
# The cargo and nix builds embed prelude/ by path (build.rs) either way.
prelude = disabled

[build]
execution_platforms = prelude//platforms:default

# Default Windows compiler identity for the shim's ovr_config//os:windows-*
# and ovr_config//compiler:* config settings; matches the prelude's default
# MSVC Windows toolchain. Set to "clang" to build with clang-cl.
[cxx]
windows_compiler_type = windows

[parser]
target_platform_detector_spec = target:root//...->prelude//platforms:default target:shim//...->prelude//platforms:default
