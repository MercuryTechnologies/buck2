load("@root//buildbuddy:defs.bzl", "buildbuddy_remote_execution_platform")

oncall("build_infra")

# Where an action's tools come from, as a constraint an execution platform
# carries so that a select in an exec_dep or a toolchain can read it.
# `nix_daemon` promises that the executor bind-mounts a nix store at
# /nix/store with its daemon's socket at /nix/var/nix/daemon-socket/socket,
# and that the daemon substitutes cache.nixos.org-signed paths for a client
# it does not trust. Lab's c1 executors do (lab's
# infra/deploy/buildbuddy/usw2/values-executor-c1.yaml and
# usw2/nix-daemon/nix.conf). `image` is everything else: tools come from
# the container image alone.
constraint(
    name = "exec_store",
    default = "image",
    values = [
        "image",
        "nix_daemon",
    ],
    visibility = ["PUBLIC"],
)

config_setting(
    name = "nix_daemon",
    constraint_values = [
        ":exec_store[nix_daemon]",
    ],
    visibility = ["PUBLIC"],
)

# Lab's own BuildBuddy remote execution: the usw2 pool of the c1 app on
# lab-build-usw2, the backend lab's infra/deploy/aws/buildbuddy.buckconfig
# names. The release build's target platforms are still
# namespace//:linux-x86_64-musl and namespace//:linux-aarch64-musl, which are
# constraint sets and name no backend; both execute here, on x86_64 executors,
# so aarch64 is a cross-compile as it was on Namespace.
#
# The executors run OCI containers, and the image is lab's thin worker
# image, the one lab's :buildbuddy platform row sends to the usw2 pool,
# pinned by digest. The build takes from it only what this contract names:
#
# - /bin, the image's PATH, whose entries link into the executor's mounted
#   nix store: the shell, bash (`[prelude] bash` in
#   .buckconfig.buildbuddy-lab), coreutils, curl, tar with gzip and xz
#   (http_archive and the rust install), unzip (the protoc archives), git
#   (git_fetch), sed, grep and nix-store;
# - /lib64/ld-linux-x86-64.so.2, the loader of every exec-side program
#   (the host rustc, rust-lld, build scripts, proc macros, CPython), which
#   finds glibc and libgcc_s in the executor's mounted nix store;
# - SSL_CERT_FILE for downloads.
#
# Nothing comes from /usr. Every compiler, library and source is pinned in
# this tree, by sha256, or by commit for the two git_fetch crates, except
# the gnu link sysroot, which
# :gnu-exec-sysroot-x86_64 builds from pinned store paths through the
# executor's nix daemon (`nix_daemon` below) and checks against a manifest.
# That action also checks that the image loader runs the pinned glibc, so
# bump this digest and those paths together, with lab's image.
# BuildBuddy's scheduler matches an executor on OSFamily, Arch and Pool
# (enterprise/server/scheduling, at v2.310.0); `usw2` is c1's amd64 pool.
# There is no local executor, so --remote-only proves every action ran
# remotely, and [buck2_re_client] comes from a file the daemon reads with no
# arguments, because neither -c nor --config-file reaches it.
buildbuddy_remote_execution_platform(
    name = "usw2_c1",
    arch = "amd64",
    constraints = ["lab_buildbuddy//:nix_daemon"],
    container_image = "docker://nscr.io/gl3j69hgbu2d6/lab-re-worker-thin:latest@sha256:96eba587c2ac177eca8c93c6920d7a7b5fe8b5bbcf1fc4b6781a2f0521eb77f8",
    cpu_configuration = "prelude//cpu:x86_64",
    os_configuration = "prelude//os:linux",
    os_family = "Linux",
    remote_execution_properties = {
        "EstimatedCPU": "2",
        "EstimatedMemory": "4GB",
        "Pool": "usw2",
    },
    visibility = ["PUBLIC"],
)

# The gnu link sysroot for build scripts and proc macros, which the
# execution platform builds for x86_64-unknown-linux-gnu and runs under the
# image's loader. It comes from four store paths of the nixpkgs that lab's
# thin worker image is built from: glibc (the image loader's own), gcc for
# crtbegin/crtend and libgcc, xgcc-libgcc for libgcc_s (on the loader's
# search path), and zlib for the host rustc's libLLVM and rust-lld
# (`rustc-libs`). The executor's nix daemon realises them, and the script
# copies the files the links need into this action's output, checked against
# gnu-exec-sysroot-x86_64.sha256, so every other action takes them by digest
# and names no store path. A path bump goes with an image bump in usw2_c1;
# :gnu-exec-sysroot-x86_64-manifest prints the new manifest.
genrule(
    name = "gnu-exec-sysroot-x86_64",
    outs = {
        "rustc-libs": ["rustc-libs"],
        "sysroot": ["sysroot"],
    },
    cmd = "sh $SRCDIR/gnu_exec_sysroot.sh $OUT $SRCDIR/gnu-exec-sysroot-x86_64.sha256 /nix/store/q4wq65gl3r8fy746v9bbwgx4gzn0r2kl-glibc-2.40-66 /nix/store/sa7j7cddyblhcb3ch3ds10w7nw75yjj1-gcc-14.3.0 /nix/store/j4kybm2h5l6ing0i494zwdswp672pmgv-xgcc-14.3.0-libgcc /nix/store/vx438ll7xvv9q5ns8mqpphsg2dxg9yi9-zlib-1.3.1",
    srcs = [
        "gnu-exec-sysroot-x86_64.sha256",
        "gnu_exec_sysroot.sh",
    ],
    target_compatible_with = [
        "lab_buildbuddy//:nix_daemon",
        "prelude//cpu:x86_64",
        "prelude//os:linux",
    ],
    visibility = ["PUBLIC"],
)

genrule(
    name = "gnu-exec-sysroot-x86_64-manifest",
    out = "gnu-exec-sysroot-x86_64.sha256",
    cmd = "sh $SRCDIR/gnu_exec_sysroot.sh $TMP/layout --print /nix/store/q4wq65gl3r8fy746v9bbwgx4gzn0r2kl-glibc-2.40-66 /nix/store/sa7j7cddyblhcb3ch3ds10w7nw75yjj1-gcc-14.3.0 /nix/store/j4kybm2h5l6ing0i494zwdswp672pmgv-xgcc-14.3.0-libgcc /nix/store/vx438ll7xvv9q5ns8mqpphsg2dxg9yi9-zlib-1.3.1 > $OUT",
    srcs = ["gnu_exec_sysroot.sh"],
    target_compatible_with = [
        "lab_buildbuddy//:nix_daemon",
        "prelude//cpu:x86_64",
        "prelude//os:linux",
    ],
)

# Links and runs a C program against the sysroot as the cxx toolchain links
# a build script, and fails if the linker opened a file outside the sysroot
# and the LLVM tree. A check, not on the release build's path.
genrule(
    name = "gnu-exec-sysroot-x86_64-selftest",
    out = "trace.txt",
    cmd = "sh $SRCDIR/gnu_exec_sysroot_selftest.sh $(location buildbuddy_toolchains//:llvm_dist) $(location lab_buildbuddy//:gnu-exec-sysroot-x86_64[sysroot]) $OUT",
    srcs = ["gnu_exec_sysroot_selftest.sh"],
    target_compatible_with = [
        "lab_buildbuddy//:nix_daemon",
        "prelude//cpu:x86_64",
        "prelude//os:linux",
    ],
)

# The host rustc's extra runtime libraries for the execution platform, as
# buildbuddy_toolchains//:rust's host_runtime_libs. An alias, so the select
# reads the execution platform's constraints.
filegroup(
    name = "no-rustc-runtime-libs",
    srcs = [],
)

alias(
    name = "rustc-runtime-libs",
    actual = select({
        "DEFAULT": "lab_buildbuddy//:no-rustc-runtime-libs",
        "lab_buildbuddy//:nix_daemon": "lab_buildbuddy//:gnu-exec-sysroot-x86_64[rustc-libs]",
    }),
    visibility = ["PUBLIC"],
)
